# Environment Configuration Template for Healthcare Appointment & Follow-up Manager

# Database Connection (SQLite for zero-config local dev or PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# For PostgreSQL: DATABASE_URL="postgresql://postgres:password@localhost:5432/healthcare_db?schema=public"

# Auth Secrets
JWT_SECRET="generate-a-secure-random-string-at-least-32-chars"
NEXTAUTH_SECRET="generate-a-secure-random-string-at-least-32-chars"
NEXTAUTH_URL="http://localhost:3000"

# LLM API Keys (Optional: OpenAI, Anthropic, or Gemini; system provides resilient clinical fallback if unset)
OPENAI_API_KEY="sk-..."
ANTHROPIC_API_KEY="sk-ant-..."
GEMINI_API_KEY="AIzaSy..."
LLM_PROVIDER="openai" # "openai" | "anthropic" | "gemini" | "auto"

# Email Configuration (Nodemailer / SendGrid / Custom SMTP)
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="your-sendgrid-or-smtp-password"
SMTP_FROM="CareFlow Clinic <appointments@yourclinic.com>"

# Google Calendar OAuth 2.0 (Google Cloud Console credentials)
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_REDIRECT_URI="http://localhost:3000/api/calendar/google/callback"

# App & Cron URL
NEXT_PUBLIC_APP_NAME="CareFlow Health"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
CRON_SECRET="your-cron-secret-key"
